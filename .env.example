# Copy this file to .env and fill in the two API keys. .env is gitignored; never commit it.
#
# The integration tests read these. The unit tests need none of them.
# See TESTING.md for how to run each.

# Which environment the integration tests hit: test or live.
# Defaults to test if unset, so forgetting this cannot aim a run at production.
INMYDATA_ENV=test


# --- Test system -------------------------------------------------------------
# Host only, no path and no port. The SDK always appends /api/developer/v1/ai/...
# This splits into tenant="test", server="test-inmydata.com".
INMYDATA_TEST_BASE_URL=https://test.test-inmydata.com
INMYDATA_TEST_API_KEY=

# The subject the data tests query. Leave blank until you know what is available:
# run the schema test and it prints every API-enabled subject for your key.
INMYDATA_TEST_SUBJECT=

# The calendar name for the CalendarAssistant tests. Blank skips them.
INMYDATA_TEST_CALENDAR=


# --- Live system -------------------------------------------------------------
# This splits into tenant="demo", server="inmydata.com".
#
# Do NOT use api.inmydata.com: that is an AWS API Gateway fronting the OData
# Lambda, it expects SigV4-signed requests rather than a Bearer token, and it
# cannot serve the SDK. See TESTING.md.
INMYDATA_LIVE_BASE_URL=https://demo.inmydata.com
INMYDATA_LIVE_API_KEY=

INMYDATA_LIVE_SUBJECT=
INMYDATA_LIVE_CALENDAR=


# --- Overrides ---------------------------------------------------------------
# The base URL above is split at the first dot of its host into the tenant and
# server arguments the SDK takes. If that split is ever wrong for your host, set
# the halves directly and they win over the base URL.
# INMYDATA_TEST_TENANT=test
# INMYDATA_TEST_SERVER=test-inmydata.com
